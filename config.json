const prefixes = [
  "baby",
  "bby",
  "bot",
  "babu",
  "janu",
  "jan",
  "leo",
  "morshed",
  "ai"
];

async function getAnswer(question) {
  const cleanQuestion = String(question || "").trim();

  if (!cleanQuestion) {
    return "❌ দয়া করে একটি প্রশ্ন লিখুন!";
  }

  try {
    const res = await apiClient.get(
      `/answer/${encodeURIComponent(cleanQuestion)}`
    );

    const answer = res && res.data && res.data.answer;

    return typeof answer === "string" && answer.trim()
      ? answer
      : NOT_TAUGHT_ANSWER;
  } catch (error) {
    console.error("getAnswer error:", error.message);
    return FALLBACK_ANSWER;
  }
}

async function fetchCount() {
  try {
    const res = await apiClient.get("/count");
    const data = res && res.data ? res.data : {};

    return {
      questions: Number.isFinite(Number(data.questions))
        ? Number(data.questions)
        : 0,
      answers: Number.isFinite(Number(data.answers))
        ? Number(data.answers)
        : 0
    };
  } catch (error) {
    console.error("fetchCount error:", error.message);
    return null;
  }
}

async function teachMultiple(qaText) {
  try {
    const res = await apiClient.post("/teach", {
      text: qaText
    });

    return (
      (res && res.data && res.data.message) ||
      "✅ শেখানোর অনুরোধ পাঠানো হয়েছে, তবে সার্ভার কোনো বার্তা দেয়নি।"
    );
  } catch (error) {
    console.error("teachMultiple error:", error.message);
    return "❌ শেখানো ব্যর্থ হয়েছে! API বা সার্ভারে সমস্যা হতে পারে।";
  }
}

function trackReply(info, event, commandName) {
  if (
    !info ||
    !info.messageID ||
    !global.GoatBot ||
    !global.GoatBot.onReply ||
    typeof global.GoatBot.onReply.set !== "function"
  ) {
    return;
  }

  global.GoatBot.onReply.set(info.messageID, {
    commandName,
    type: "reply",
    messageID: info.messageID,
    author: event.senderID
  });
}

function sendTrackedMessage(api, message, event, commandName) {
  return api.sendMessage(
    message,
    event.threadID,
    (err, info) => {
      if (err) {
        console.error("sendMessage error:", err.message || err);
        return;
      }

      trackReply(info, event, commandName);
    },
    event.messageID
  );
}

function parseChatPrefix(body) {
  for (const prefix of prefixes) {
    if (body === prefix) {
      return {
        prefix,
        question: ""
      };
    }

    if (body.startsWith(prefix)) {
      const nextChar = body.charAt(prefix.length);

      if (/\s|[,!:;?.-]/.test(nextChar)) {
        const question = body
          .slice(prefix.length)
          .replace(/^[\s,!:;?.-]+/, "")
          .trim();

        return {
          prefix,
          question
        };
      }
    }
  }

  return null;
}

module.exports = {
  config: {
    name: "jan",
    version: "1.5.0",
    author: "Aminul Sardar",
    countDown: 0,
    role: 0,
    aliases: ["jaan", "janu", "bby"],
    shortDescription: "Jan AI চ্যাটবট",
    longDescription:
      "Jan AI বট যেটা শেখানো যেতে পারে এবং প্রশ্নের উত্তর দিতে পারে।",
    category: "jan",
    guide:
      "{pn} <message>\n" +
      "{pn} teach <প্রশ্ন> - <উত্তর>\n" +
      "{pn} count"
  },

  async fetchCount() {
    return await fetchCount();
  },

  async getAnswer(question) {
    return await getAnswer(question);
  },

  async teachMultiple(qaText) {
    return await teachMultiple(qaText);
  },

  onReply: async function ({ api, event }) {
    try {
      const reply = String(event.body || "").trim();

      if (!reply) {
        return;
      }

      const responseMessage = await getAnswer(reply);

      return sendTrackedMessage(
        api,
        responseMessage,
        event,
        this.config.name
      );
    } catch (error) {
      console.error("onReply error:", error.message);

      return api.sendMessage(
        FALLBACK_ANSWER,
        event.threadID,
        event.messageID
      );
    }
  },

  onStart: async function ({ api, args, event }) {
    try {
      if (!args || args.length < 1) {
        return api.sendMessage(
          "❌ দয়া করে একটি প্রশ্ন করুন!",
          event.threadID,
          event.messageID
        );
      }

      const command = String(args[0] || "").toLowerCase();

      if (command === "count") {
        const count = await fetchCount();

        if (!count) {
          return api.sendMessage(
            "❌ এখন জ্ঞানভাণ্ডারের তথ্য পাওয়া যাচ্ছে না। পরে চেষ্টা করুন।",
            event.threadID,
            event.messageID
          );
        }

        return api.sendMessage(
          `📊 জ্ঞানভাণ্ডার:\n\n` +
            `📌 মোট প্রশ্ন: ${count.questions}\n` +
            `📌 মোট উত্তর: ${count.answers}\n\n` +
            `💡 আমাকে আরও শেখানোর মাধ্যমে আমাকে আরও স্মার্ট বানান!`,
          event.threadID,
          event.messageID
        );
      }

      if (command === "teach") {
        const input = args.slice(1).join(" ").trim();

        if (!input || !input.includes(" - ")) {
          return api.sendMessage(
            "❌ সঠিক ফরম্যাট ব্যবহার করুন:\n" +
              "/jan teach প্রশ্ন - উত্তর\n\n" +
              "একাধিক প্রশ্নের ফরম্যাট API-তে সমর্থিত কি না নিশ্চিত হয়ে নিন।",
            event.threadID,
            event.messageID
          );
        }

        const message = await teachMultiple(input);

        return api.sendMessage(
          message,
          event.threadID,
          event.messageID
        );
      }

      const input = args.join(" ").trim();
      const responseMessage = await getAnswer(input);

      return sendTrackedMessage(
        api,
        responseMessage,
        event,
        this.config.name
      );
    } catch (error) {
      console.error("onStart error:", error.message);

      return api.sendMessage(
        FALLBACK_ANSWER,
        event.threadID,
        event.messageID
      );
    }
  },

  onChat: async function ({ api, event }) {
    try {
      const body = String(event.body || "").toLowerCase().trim();

      if (!body) {
        return;
      }

      const parsed = parseChatPrefix(body);

      if (!parsed) {
        return;
      }

      if (parsed.question) {
        const response = await getAnswer(parsed.question);

        return sendTrackedMessage(
          api,
          response,
          event,
          this.config.name
        );
      }

      const reply =
        randomReplies[Math.floor(Math.random() * randomReplies.length)];

      return sendTrackedMessage(
        api,
        reply,
        event,
        this.config.name
      );
    } catch (error) {
      console.error("onChat error:", error.message);
    }
  }
};
